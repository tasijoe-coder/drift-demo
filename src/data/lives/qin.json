        "fan": {
          "text": "他冒雨幫孟家搶收曬穀，孟員外第一次正眼看了這個書生。",
          "fx": {
            "bond": 1
          },
          "set": [
            "father_likes"
          ]
        },
        "li": {
          "text": "趙督工躲雨躲進孟家門廊，瞥見後院有個來路不明的年輕人。",
          "fx": {
            "jie": 2
          }
        },
        "zhang": {
          "text": "張公子淋雨病倒，提親延後。他躺在床上，把這筆帳記在孟家頭上。",
          "fx": {
            "bond": 1,
            "rule": 1
          },
          "set": [
            "zhang_grudge"
          ]
        }
      }
    },
