  "cards": [
    {
      "id": "garden",
      "act": 0,
      "fixed": 0,
      "omen": "一陣風",
      "text": "范喜良為了躲徵役，翻牆逃進孟家後花園。孟姜女正在池邊撲蝶，牆外是追捕的官差。",
      "options": {
        "meng": {
          "text": "風吹落她的團扇，正好落在他藏身的樹叢前。兩人四目相對，誰都沒出聲。",
          "fx": {
            "bond": 1
          }
        },
        "fan": {
          "text": "風吹動樹叢，他慌忙中跌進池裡。孟姜女笑了一聲——你心頭一緊，這一笑，跟天上那一笑一模一樣。",
          "fx": {
            "bond": 1,
            "rule": 1
          },
          "set": [
            "echo_smile"
          ]
        },
        "li": {
          "text": "風把牆外的腳印吹散，追捕的趙督工在巷口繞了一圈，走了。",
          "fx": {
            "jie": -1,
            "bond": 1
          }
        },
        "zhang": {
          "text": "風把張家媒人的帽子吹進池塘，提親的隊伍亂成一團，今天說不成了。",
          "fx": {
            "bond": 1
          },
          "set": [
            "zhang_delay"
          ]
        }
      }
    },
    {
      "id": "rain_match",
      "act": 0,
      "omen": "一場大雨",
